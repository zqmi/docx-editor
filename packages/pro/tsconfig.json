{
  "compilerOptions": {
    // ES2022 rather than ES2020 because this program contains core's sources through the
    // `paths` below, and they use ES2022 features (`Array.prototype.at`, `Error.cause`).
    // An ES2020 floor only appears to work: `@types/bun` pulls in `@types/node`, whose
    // `compatibility/indexable.d.ts` back-declares `.at` for older libs, so the gap hides
    // until something type-checks without those ambient types.
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@onsitesai/docx-editor-i18n": ["../i18n/src/index.ts"],
      "@onsitesai/docx-editor-i18n/*": ["../i18n/src/*.ts"],
      // core's and react's export maps point at dist, which typecheck never builds.
      // Map every subpath this package reaches for to source, or the same type arrives
      // under two identities depending on whether a build happens to be lying around.
      "@onsitesai/docx-editor-core": ["../core/src/index.ts"],
      "@onsitesai/docx-editor-core/automation": ["../core/src/automation/index.ts"],
      "@onsitesai/docx-editor-core/binding": ["../core/src/binding/index.ts"],
      "@onsitesai/docx-editor-core/contracts/editor": ["../core/src/contracts/editor.ts"],
      "@onsitesai/docx-editor-core/contracts/document": ["../core/src/contracts/document.ts"],
      "@onsitesai/docx-editor-core/contracts/interaction": ["../core/src/contracts/interaction.ts"],
      "@onsitesai/docx-editor-core/contracts/mcp": ["../core/src/contracts/mcp.ts"],
      "@onsitesai/docx-editor-core/contracts/modules": ["../core/src/contracts/modules.ts"],
      "@onsitesai/docx-editor-core/contracts/plugin": ["../core/src/contracts/plugin.ts"],
      "@onsitesai/docx-editor-core/contracts/types": ["../core/src/contracts/types-barrel.ts"],
      "@onsitesai/docx-editor-core/layout": ["../core/src/layout/index.ts"],
      "@onsitesai/docx-editor-core/output": ["../core/src/output/index.ts"],
      "@onsitesai/docx-editor-core/store": ["../core/src/store/index.ts"],
      "@onsitesai/docx-editor-core/editor": ["../core/src/editor/index.ts"],
      "@onsitesai/docx-editor-core/collaboration/replication": [
        "../core/src/collaboration/replication.ts"
      ],
      "@onsitesai/docx-editor-core/collaboration": ["../core/src/collaboration/index.ts"],
      "@docx-editor.dev/editor-api": ["../editor-api/src/index.ts"],
      "@docx-editor.dev/editor-api/browser": ["../editor-api/src/browser.ts"],
      "@onsitesai/docx-editor-react": ["../react/src/index.ts"],
      "@docx-editor.dev/vue": ["../vue/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "src/vue",
    // Every Vue-side test, for the same reason `src/vue` is excluded: this config compiles
    // JSX as React, so a test that reaches `@docx-editor.dev/vue` drags the Vue package's
    // `.tsx` into a React-JSX program and produces thousands of VNode-vs-ReactNode errors.
    // `exclude` only filters the `include` glob, so each one has to be named here.
    "src/__tests__/collaboration-presence-ui-vue.test.ts",
    "src/__tests__/custom-node-vue-chrome.test.ts",
    "src/__tests__/review-sidebar-vue.test.ts",
    "src/__tests__/review-compact-card-vue.test.ts",
    "src/__tests__/review-reply-author-vue.test.ts",
    "src/__tests__/review-adopt-vue.test.ts",
    "src/__tests__/review-region-vue.test.ts",
    "src/__tests__/formatting-page-balloon-vue.test.ts",
    "src/__tests__/review-balloons-vue.test.ts",
    "src/__tests__/review-vue-harness.ts",
    "src/__tests__/use-collaboration-participants-vue.test.ts",
    "src/__tests__/use-document-collaboration-vue.test.ts",
    "src/__tests__/use-hocuspocus-collaboration-vue.test.ts",
    "src/__tests__/use-webrtc-collaboration-vue.test.ts",
    "src/collaboration/__tests__/use-collaboration-status-vue.test.ts"
  ]
}
