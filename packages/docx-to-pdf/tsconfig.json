{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "paths": {
      // Keep every published core subpath on source. A missing entry falls through to dist,
      // mixing stale declarations with the source graph and making clean typechecks build-order
      // dependent.
      "@onsitesai/docx-editor-core": ["../core/src/index.ts"],
      "@onsitesai/docx-editor-core/automation": ["../core/src/automation/index.ts"],
      "@onsitesai/docx-editor-core/binding": ["../core/src/binding/index.ts"],
      "@onsitesai/docx-editor-core/collaboration": ["../core/src/collaboration/index.ts"],
      "@onsitesai/docx-editor-core/collaboration/replication": [
        "../core/src/collaboration/replication.ts"
      ],
      "@onsitesai/docx-editor-core/contracts/document": ["../core/src/contracts/document.ts"],
      "@onsitesai/docx-editor-core/contracts/editor": ["../core/src/contracts/editor.ts"],
      "@onsitesai/docx-editor-core/contracts/interaction": ["../core/src/contracts/interaction.ts"],
      "@onsitesai/docx-editor-core/contracts/modules": ["../core/src/contracts/modules.ts"],
      "@onsitesai/docx-editor-core/contracts/types": ["../core/src/contracts/types-barrel.ts"],
      "@onsitesai/docx-editor-core/export": ["../core/src/export/index.ts"],
      "@onsitesai/docx-editor-core/editor": ["../core/src/editor/index.ts"],
      "@onsitesai/docx-editor-core/layout": ["../core/src/layout/index.ts"],
      "@onsitesai/docx-editor-core/output": ["../core/src/output/index.ts"],
      "@onsitesai/docx-editor-core/store": ["../core/src/store/index.ts"],
      "@onsitesai/docx-editor-fonts": ["../fonts/src/index.ts"],
      "@docx-editor.dev/fonts-cjk": ["../fonts-cjk/src/index.ts"]
    }
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist"]
}
