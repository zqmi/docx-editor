{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowImportingTsExtensions": true,
    "paths": {
      "@onsitesai/docx-editor-core": ["./src/index.ts"],
      "@onsitesai/docx-editor-core/automation": ["./src/automation/index.ts"],
      "@onsitesai/docx-editor-core/binding": ["./src/binding/index.ts"],
      "@onsitesai/docx-editor-core/collaboration/replication": ["./src/collaboration/replication.ts"],
      "@onsitesai/docx-editor-core/collaboration": ["./src/collaboration/index.ts"],
      "@onsitesai/docx-editor-core/contracts/editor": ["./src/contracts/editor.ts"],
      "@onsitesai/docx-editor-core/contracts/document": ["./src/contracts/document.ts"],
      "@onsitesai/docx-editor-core/contracts/interaction": ["./src/contracts/interaction.ts"],
      "@onsitesai/docx-editor-core/contracts/modules": ["./src/contracts/modules.ts"],
      "@onsitesai/docx-editor-core/contracts/types": ["./src/contracts/types-barrel.ts"],
      "@onsitesai/docx-editor-core/layout": ["./src/layout/index.ts"],
      "@onsitesai/docx-editor-core/output": ["./src/output/index.ts"],
      "@onsitesai/docx-editor-core/store": ["./src/store/index.ts"],
      "@onsitesai/docx-editor-core/editor": ["./src/editor/index.ts"],
      "@onsitesai/docx-editor-core/export": ["./src/export/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/store/__tests__",
    "src/layout/__tests__",
    "src/output/__tests__",
    "src/binding/__tests__",
    "src/editor/__tests__"
  ]
}
