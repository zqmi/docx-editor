{
  "compilerOptions": {
    // ES2022 rather than ES2020 because this program contains core's sources through the
    // `paths` below, and they use ES2022 features (`Array.prototype.at`, `Error.cause`).
    // An ES2020 floor only appears to work: `@types/bun` pulls in `@types/node`, whose
    // `compatibility/indexable.d.ts` back-declares `.at` for older libs, so the gap hides
    // until something type-checks without those ambient types.
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "paths": {
      // core's export map points at dist, which typecheck never builds. Map every
      // subpath this package reaches for to source, or the same type arrives under
      // two identities depending on whether a build happens to be lying around.
      "@zqmi/docx-editor-core": ["../core/src/index.ts"],
      "@zqmi/docx-editor-core/automation": ["../core/src/automation/index.ts"],
      "@zqmi/docx-editor-core/binding": ["../core/src/binding/index.ts"],
      "@zqmi/docx-editor-core/contracts/editor": ["../core/src/contracts/editor.ts"],
      "@zqmi/docx-editor-core/contracts/document": ["../core/src/contracts/document.ts"],
      "@zqmi/docx-editor-core/contracts/interaction": ["../core/src/contracts/interaction.ts"],
      "@zqmi/docx-editor-core/contracts/mcp": ["../core/src/contracts/mcp.ts"],
      "@zqmi/docx-editor-core/contracts/modules": ["../core/src/contracts/modules.ts"],
      "@zqmi/docx-editor-core/contracts/plugin": ["../core/src/contracts/plugin.ts"],
      "@zqmi/docx-editor-core/contracts/types": ["../core/src/contracts/types-barrel.ts"],
      "@zqmi/docx-editor-core/layout": ["../core/src/layout/index.ts"],
      "@zqmi/docx-editor-core/output": ["../core/src/output/index.ts"],
      "@zqmi/docx-editor-core/store": ["../core/src/store/index.ts"],
      "@zqmi/docx-editor-core/editor": ["../core/src/editor/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
