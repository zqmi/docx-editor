{
  // API Extractor's view of this package — see `packages/core/tsconfig.api.json`. Fonts reaches
  // core only in its tests, but the redirect keeps a stray specifier off core's `.ts` source.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@zqmi/docx-editor-core": ["../core/dist/index.d.ts"],
      "@zqmi/docx-editor-core/contracts/*": ["../core/dist/contracts/*.d.ts"],
      "@zqmi/docx-editor-core/*": ["../core/dist/*.d.ts"]
    }
  }
}
