{
  // Compiles `declared-lifecycle.ts`: the runtime measured against the authored declarations.
  //
  // Its own project because it is the only place in this slice that reads `compat/`, and because
  // the negative fixture beside it must be compiled separately, expecting failure.
  //
  // Strictness matches `packages/core/tsconfig.json` for the reason given in
  // `../tsconfig.neutral.json`: the program necessarily contains core's sources.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      // Every published subpath, mapped to source. The export map points at dist, so a subpath
      // missing here resolves to built .d.ts while its siblings resolve to src, and the same
      // type then arrives under two identities.
      "@zqmi/docx-editor-core": ["../../../../core/src/index.ts"],
      "@zqmi/docx-editor-core/automation": ["../../../../core/src/automation/index.ts"],
      "@zqmi/docx-editor-core/binding": ["../../../../core/src/binding/index.ts"],
      "@zqmi/docx-editor-core/contracts/editor": ["../../../../core/src/contracts/editor.ts"],
      "@zqmi/docx-editor-core/contracts/document": ["../../../../core/src/contracts/document.ts"],
      "@zqmi/docx-editor-core/contracts/interaction": [
        "../../../../core/src/contracts/interaction.ts"
      ],
      "@zqmi/docx-editor-core/contracts/mcp": ["../../../../core/src/contracts/mcp.ts"],
      "@zqmi/docx-editor-core/contracts/modules": ["../../../../core/src/contracts/modules.ts"],
      "@zqmi/docx-editor-core/contracts/plugin": ["../../../../core/src/contracts/plugin.ts"],
      "@zqmi/docx-editor-core/contracts/types": ["../../../../core/src/contracts/types-barrel.ts"],
      "@zqmi/docx-editor-core/layout": ["../../../../core/src/layout/index.ts"],
      "@zqmi/docx-editor-core/output": ["../../../../core/src/output/index.ts"],
      "@zqmi/docx-editor-core/store": ["../../../../core/src/store/index.ts"],
      "@zqmi/docx-editor-core/editor": ["../../../../core/src/editor/index.ts"]
    }
  },
  "include": ["declared-lifecycle.ts"],
  "exclude": ["node_modules", "__negative__"]
}
