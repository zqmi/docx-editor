{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Map the workspace packages to their SOURCES. Resolving them through package exports
    // would need a built `dist`, which CI does not have when it runs typecheck.
    "paths": {
      "@onsitesai/docx-editor-core": ["../../packages/core/src/index.ts"],
      "@onsitesai/docx-editor-core/*": ["../../packages/core/src/*"],
      "@onsitesai/docx-editor-fonts": ["../../packages/fonts/src/index.ts"],
      "@onsitesai/docx-editor-i18n": ["../../packages/i18n/src/index.ts"],
      "@docx-editor.dev/pro": ["../../packages/pro/src/index.ts"],
      "@docx-editor.dev/pro/*": ["../../packages/pro/src/*"],
      "@onsitesai/docx-editor-react": ["../../packages/react/src/index.ts"]
    },
    "types": ["bun", "vite/client"]
  },
  "include": ["src", "server", "shared"]
}
