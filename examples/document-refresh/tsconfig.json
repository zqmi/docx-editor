{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "@zqmi/docx-editor-core": ["../../packages/core/src/index.ts"],
      "@zqmi/docx-editor-core/*": ["../../packages/core/src/*"],
      "@zqmi/docx-editor-i18n": ["../../packages/i18n/src/index.ts"],
      "@zqmi/docx-editor-react": ["../../packages/react/src/index.ts"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
